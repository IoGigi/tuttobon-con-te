{
  "name": "TuttoBon con te",
  "short_name": "TuttoBon con te",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "share_target": {
    "action": "./condividi-buono",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "voucher",
          "accept": [
            "application/pdf",
            "image/jpeg",
            "image/png",
            "image/webp"
          ]
        }
      ]
    }
  }
}